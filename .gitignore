# ==========================================
# 🛡️ Polyglot Safe Copy - Project Gitignore
# ==========================================

# --- Core Automation Artifacts ---
# Ignores all dynamic runtime log files generated by the scripts
copy_log_*.log
*.log

# --- Local Test Infrastructure ---
# Blocks local simulation directories from being committed
test_src/
test_dest/
empty_src/

# --- 🐚 Bash & System OS ---
.DS_Store
Thumbs.db
*.swp
*~

# --- 🟨 Node.js / JavaScript ---
node_modules/
package-lock.json
npm-debug.log*

# --- 🔵 Go (Golang) ---
# Blocks compiled executable binaries
*.exe
*.exe~
*.dll
*.so
*.dylib
# If you compile main.go into a binary named 'main' or 'safe_copy'
main
safe_copy

# --- 🐍 Python ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv
venv/
ENV/

# --- 🐘 PHP ---
.phpunit.result.cache
.php_cs.cache
